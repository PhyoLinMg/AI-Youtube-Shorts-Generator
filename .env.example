# API mode (default)
MUAPI_API_KEY=your_muapi_key_here

# Local mode (--mode local)
LLM_PROVIDER=openai           # openai, gemini, or openrouter
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini   # used for visual-hook scoring; must be vision-capable
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=auto
LOCAL_OUTPUT_DIR=output
SHORT_FILENAME_STYLE=specific   # specific=title1.mp4 (slugified title) | generic=video1.mp4
YT_DLP_COOKIES_FROM_BROWSER=   # e.g. chrome -- fixes YouTube 429/bot-check; needs real Keychain access, not a headless shell

# Thread compilation (--clip-type thread, local mode only)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
